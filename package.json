{
    "name": "powercrm-sidekick-zoho",
    "displayName": "PowerCRM SideKick Zoho",
    "version": "0.1.0",
    "description": "A side panel for Zoho CRM administrators: metadata browser, record viewer and quick navigation to setup.",
    "author": "frauhottelmann (based on PowerCRM SideKick 365 by Sofiane GUEZZAR)",
    "scripts": {
        "dev": "plasmo dev",
        "build": "pnpm run build:chrome && pnpm run build:firefox",
        "build:chrome": "plasmo build --target=chrome-mv3",
        "build:firefox": "plasmo build --target=firefox-mv3",
        "package": "pnpm run package:chrome && pnpm run package:firefox",
        "package:chrome": "plasmo package --target=chrome-mv3",
        "package:firefox": "plasmo package --target=firefox-mv3"
    },
    "dependencies": {
        "@custom-react-hooks/all": "^2.0.8",
        "@emotion/cache": "^11.14.0",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@hello-pangea/dnd": "^18.0.1",
        "@monaco-editor/react": "^4.7.0",
        "@mui/icons-material": "^7.3.4",
        "@mui/lab": "7.0.1-beta.18",
        "@mui/material": "^7.3.4",
        "@mui/styles": "^6.4.8",
        "@mui/x-data-grid": "^7.24.0",
        "@mui/x-date-pickers": "^8.12.0",
        "@react-icons/all-files": "^4.1.0",
        "@uiw/react-json-view": "2.0.0-alpha.39",
        "autonumeric": "^4.10.9",
        "clsx": "^2.1.1",
        "csstype": "^3.1.3",
        "dayjs": "^1.11.18",
        "material-ui-confirm": "^4.0.0",
        "monaco-editor": "^0.37.1",
        "next": "^15.5.4",
        "notistack": "^3.0.2",
        "plasmo": "0.90.5",
        "react": "18.2.0",
        "react-dom": "18.2.0",
        "react-hotkeys-hook": "^5.1.0",
        "react-textfit": "^1.1.1",
        "react-virtuoso": "^4.14.1",
        "usehooks-ts": "^3.1.1"
    },
    "devDependencies": {
        "@ianvs/prettier-plugin-sort-imports": "4.1.1",
        "@mui/types": "^7.4.7",
        "@plasmohq/parcel-resolver": "^0.14.2",
        "@types/chrome": "0.0.258",
        "@types/node": "20.11.5",
        "@types/react": "18.2.48",
        "@types/react-dom": "18.2.18",
        "@types/react-textfit": "^1.1.4",
        "crypto-browserify": "^3.12.1",
        "prettier": "3.2.4",
        "typescript": "5.3.3"
    },
    "manifest": {
        "host_permissions": [
            "https://crm.zoho.com/*",
            "https://crm.zoho.eu/*",
            "https://crm.zoho.in/*",
            "https://crm.zoho.com.au/*",
            "https://crm.zoho.jp/*",
            "https://crm.zoho.com.cn/*",
            "https://crm.zoho.sa/*",
            "https://crm.zohocloud.ca/*",
            "https://crmsandbox.zoho.com/*",
            "https://crmsandbox.zoho.eu/*",
            "https://crmsandbox.zoho.in/*",
            "https://crmsandbox.zoho.com.au/*",
            "https://crmsandbox.zoho.jp/*",
            "https://crmsandbox.zoho.com.cn/*",
            "https://crmsandbox.zoho.sa/*",
            "https://crmsandbox.zohocloud.ca/*"
        ],
        "permissions": [
            "storage"
        ],
        "browser_specific_settings": {
            "gecko": {
                "id": "powercrm-sidekick-zoho@frauhottelmann.github.io"
            }
        }
    },
    "pnpm": {
        "patchedDependencies": {
            "math-intrinsics@1.1.0": "patches/math-intrinsics@1.1.0.patch"
        },
        "overrides": {
            "glob": "^10.5.0"
        }
    }
}
